# ==============================================================================
# FluxDesk Environment Configuration (.env.example)
# ==============================================================================

# Core Ports
PORT=4000
WORKER_PORT=4001
CLIENT_PORT=5173

# Apache Kafka (KRaft mode)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=fluxdesk-cluster
KAFKA_GROUP_ID=fluxdesk-worker-group
KAFKA_TOPIC_INCOMING=ticket.incoming
KAFKA_TOPIC_PROCESSED=ticket.processed
KAFKA_TOPIC_DLQ=ticket.dlq

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MongoDB
MONGO_URI=mongodb://localhost:27017/fluxdesk
MONGO_DB_NAME=fluxdesk

# LLM / AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Security & JWT
JWT_SECRET=fluxdesk_dev_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Rate Limiting Defaults
DEFAULT_TENANT_RATE_LIMIT_PER_MINUTE=60
